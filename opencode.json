
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {}
  },
  "model": "opencode/trinity-large-preview-free",
  "small_model": "opencode/trinity-large-preview-free",

  "mcp": {
    "jira": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "https://ditstek-agent.atlassian.net",
        "JIRA_USERNAME": "{env:JIRA_EMAIL}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    }
  }
}
