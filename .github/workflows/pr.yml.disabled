# PR pipeline for code review: lint, test, build.

name: FE PR Pipeline Check

on:
  push:
    branches: [dev]
  pull_request:
    branches: [dev]

jobs:
  validate:
    name: Lint, Test and Build (${{ github.ref_name }})
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Triggered by branch
        run: echo "Branch that triggered this run - ${{ github.ref_name }}"

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: latest

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Lint
        run: pnpm run lint

      # - name: Test
      #   run: pnpm test -- --ci --passWithNoTests

      - name: Build
        run: pnpm run build
